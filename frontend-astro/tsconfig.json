{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", ".astro/types.d.ts"],
  "exclude": ["dist", "node_modules", "src/**/*.test.ts"]
}
