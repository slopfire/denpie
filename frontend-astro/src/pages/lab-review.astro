---
import "../styles/global.css";
import { LabReviewWorkbench } from "@/components/content/LabReviewWorkbench";
import { parseLabReviewPayload } from "@/lib/lab-review";
import { t } from "@/lib/i18n";

declare const __LAB_REVIEW_PAYLOAD__: string;

const raw: unknown = JSON.parse(__LAB_REVIEW_PAYLOAD__);
const payload = raw === null ? null : parseLabReviewPayload(raw);
---

<!doctype html>
<html lang="en" data-theme="shadcn">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Run review · Denpie Lab</title>
    </head>
    <body class="bg-background text-foreground">
        <main>
            <header class="mx-auto w-full max-w-[1600px] border-b border-border px-4 pt-8 pb-6">
                <h1 class="text-2xl font-bold">{t("lab.review.page_title")}</h1>
                <p class="mt-2 text-muted-foreground">
                    {t("lab.review.page_description")}
                </p>
            </header>
            {payload === null ? (
                <div class="mx-auto max-w-3xl px-4 py-12">
                    <p class="rounded-xl border border-border bg-card p-6 text-muted-foreground">
                        {t("lab.review.page_empty")}
                    </p>
                </div>
            ) : (
                <LabReviewWorkbench client:load payload={payload} />
            )}
        </main>
    </body>
</html>
