{
    "name": "denpie-frontend-astro",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "typecheck": "astro sync && tsc --noEmit",
        "test": "bun test",
        "generate:topic-icons": "node ../scripts/generate-topic-icons.mjs",
        "check:topic-icons": "node ../scripts/generate-topic-icons.mjs --check",
        "check:i18n": "node ../scripts/check-astro-i18n.mjs",
        "generate:proto": "mkdir -p src/generated && protoc --plugin=protoc-gen-es=./node_modules/.bin/protoc-gen-es --es_out=src/generated --es_opt=target=ts -I../proto ../proto/denpie.proto",
        "check:proto": "sh ../scripts/check-proto-gen.sh"
    },
    "dependencies": {
        "@astrojs/react": "^6.0.4",
        "@base-ui/react": "^1.7.0",
        "@bufbuild/protobuf": "2.14.0",
        "@fontsource-variable/geist": "^5.3.0",
        "@iconify/react": "^6.0.2",
        "astro": "^7.2.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.33.0",
        "prismjs": "^1.30.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "shadcn": "^4.19.0",
        "tailwind-merge": "^3.2.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@bufbuild/protoc-gen-es": "2.14.0",
        "@iconify-json/lucide": "^1.2.125",
        "@iconify-json/mdi": "^1.2.3",
        "@iconify-json/radix-icons": "^1.2.6",
        "@iconify-json/tabler": "^1.2.38",
        "@tailwindcss/vite": "^4.1.4",
        "@types/prismjs": "^1.26.6",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.1.4",
        "typescript": "^5.8.3"
    }
}
